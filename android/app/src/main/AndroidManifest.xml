<?xml version="1.0" encoding="utf-8"?>
<!-- Maptale-Aufnahme: GPS-Track + Fotos aufzeichnen, Touren hochladen und im
     WebView-Player abspielen. Kein ACCESS_BACKGROUND_LOCATION nötig — der
     Foreground-Service startet, während die App im Vordergrund ist. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Video-Ton (M4); ohne die Erlaubnis wird stumm aufgenommen -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foto-Nachzug zu Cloud-Touren: die Galerie im Zeitfenster einer Tour
         lesen. Ab Android 13 das feinere READ_MEDIA_IMAGES, darunter das grobe
         READ_EXTERNAL_STORAGE — deshalb `maxSdkVersion`, sonst verlangte die App
         auf neuen Geräten beides. Erfragt wird es erst, wenn jemand den Nachzug
         einschaltet oder einem Vorschlag zustimmt. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Ohne diese Erlaubnis entfernt Android den GPS-Ort aus jedem Bild, das
         die App liest (seit Android 10). Sie ist NICHT Voraussetzung: Fehlt der
         Anker, platziert der Server das Foto über seine Aufnahmezeit am Track. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Fortbewegung erkennen (Play Services Activity Recognition). Ab API 29
         eine Runtime-Berechtigung; ohne sie zeichnet die App ohne Automatik auf. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".MaptaleApp"
        android:label="Maptale"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Maptale"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/netz_sicherheit"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Rückweg aus dem Browser nach dem Verknüpfen eines Trackers:
                 `maptale://tracker/<anbieter>?ok=1`. Ein eigenes Schema und
                 kein https-App-Link, weil dafür eine assetlinks.json auf der
                 Domain nötig wäre — die Adresse hier ist kein Ort im Web,
                 sondern ein Rückruf, den nur diese App beantwortet. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="maptale" android:host="tracker" />
            </intent-filter>
        </activity>

        <service
            android:name=".aufzeichnung.AufzeichnungsService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Push: weckt die App, wenn eine Cloud-Tour fertig ist. Der Dienst
             läuft auch ohne google-services.json im Build mit — Firebase
             initialisiert sich dann schlicht nicht und ruft ihn nie auf. -->
        <service
            android:name=".push.MaptalePushDienst"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Die Übertragung beginnt VOR der ersten Nachricht: firebase-messaging
             zieht firebase-installations mit, und die meldet beim App-Start eine
             Installations-ID an Google — auch wenn nie ein Push verschickt wird.
             Deshalb aus, bis jemand zugestimmt hat (MaptalePush.aktiviere). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- Ohne diese Freigabe wirft `register()` mit „API disabled": Seit FCM
             die Installations-ID zur Adresse gemacht hat, muss eine App
             ausdrücklich erlauben, dass sie dafür benutzt wird. Am Gerät
             gefunden — die Testsuite kann es nicht sehen, weil Firebase dort
             gar nicht erst initialisiert.

             Das hebt die Zeile darüber NICHT auf: `auto_init` entscheidet, ob
             von SELBST registriert wird (nein), dies nur, ob es überhaupt
             möglich ist. Übertragen wird weiterhin erst, wenn
             `MaptalePush.aktiviere` es nach der Zustimmung anstößt. -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <!-- Gilt für alle Firebase-Bestandteile, die von sich aus Daten sammeln
             würden. `firebase-analytics` ist gar nicht erst als Abhängigkeit
             aufgenommen; dies ist der Riegel für den Fall, dass es über eine
             andere Bibliothek doch einmal hereinkäme. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
    </application>
</manifest>
