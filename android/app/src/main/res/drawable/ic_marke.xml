<?xml version="1.0" encoding="utf-8"?>
<!--
  ERZEUGT von scripts/gen-logo.mjs — nicht von Hand pflegen, sonst driftet die Marke
  von public/logo-mark.svg weg. Änderungen dort im Skript machen und neu erzeugen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="40"
    android:viewportHeight="40">

    <!-- Umriss, aufgerissen an den Durchstoßpunkten der Route -->
    <path
        android:pathData="M33.41,12.85 A15.2,15.2 0 0 0 4.8,19.81"
        android:strokeColor="#F59E0B"
        android:strokeWidth="1.25"
        android:strokeAlpha="0.78"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M6.26,26.49 A15.2,15.2 0 0 0 35.19,19.45"
        android:strokeColor="#F59E0B"
        android:strokeWidth="1.25"
        android:strokeAlpha="0.78"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Gitter: gekippte Kugel (Meridian + Breitenkreise) -->
    <group
        android:rotation="-17"
        android:pivotX="20"
        android:pivotY="20">
        <path
            android:pathData="M4.8,20 L35.2,20"
            android:strokeColor="#F59E0B"
            android:strokeWidth="0.8"
            android:strokeAlpha="0.3"
            android:fillColor="#00000000" />
        <path
            android:pathData="M7.11,11.95 L32.89,11.95"
            android:strokeColor="#F59E0B"
            android:strokeWidth="0.8"
            android:strokeAlpha="0.3"
            android:fillColor="#00000000" />
        <path
            android:pathData="M7.11,28.05 L32.89,28.05"
            android:strokeColor="#F59E0B"
            android:strokeWidth="0.8"
            android:strokeAlpha="0.3"
            android:fillColor="#00000000" />
        <path
            android:pathData="M20,4.8 A8.5,15.2 0 1 1 20,35.2 A8.5,15.2 0 1 1 20,4.8"
            android:strokeColor="#F59E0B"
            android:strokeWidth="0.8"
            android:strokeAlpha="0.3"
            android:fillColor="#00000000" />
    </group>

    <!-- Route -->
    <path
        android:pathData="M4.4,23.4 C12.4,13.4 27.2,26.6 35.6,15.8"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="4.4"
                android:startY="23.4"
                android:endX="35.6"
                android:endY="15.8">
                <item android:offset="0" android:color="#F0940A" />
                <item android:offset="1" android:color="#FF8A5C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Start -->
    <path
        android:pathData="M4.4,23.4 m-1.6,0 a1.6,1.6 0 1,1 3.2,0 a1.6,1.6 0 1,1 -3.2,0"
        android:fillColor="#F59E0B" />

    <!-- Ziel -->
    <path
        android:pathData="M35.6,15.8 m-1.9,0 a1.9,1.9 0 1,1 3.8,0 a1.9,1.9 0 1,1 -3.8,0"
        android:fillColor="#F2EDE3" />
</vector>
