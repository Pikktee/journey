{
  "name": "maptale",
  "private": true,
  "version": "0.69.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "release": "bash scripts/release.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prelint": "node -e \"if(!require('fs').existsSync('server/node_modules')){console.error('server/node_modules fehlt: erst (cd server && npm ci). Ohne die Server-Typen ist jeder Fastify-Body any und die unsafe-Familie meldet Tausende Phantom-Befunde.');process.exit(1)}\"",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs}\"",
    "docs": "node scripts/docs-viewer/build.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "mediabunny": "^1.54.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "marked": "^18.0.9",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
